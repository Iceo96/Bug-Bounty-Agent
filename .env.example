# Copy to .env and fill in. .env is git-ignored — never commit secrets.

# LLM provider key for the Agent Brain (optional until the brain is wired up).
# The Agent Brain has NO direct network or shell access; it only calls controlled tools.
ANTHROPIC_API_KEY=

# Path to the SQLite database for the attack-surface map and evidence store.
BBAGENT_DB_PATH=./data/bbagent.db

# Root directory for stored raw evidence blobs.
BBAGENT_EVIDENCE_DIR=./evidence

# Logging: DEBUG | INFO | WARNING | ERROR
BBAGENT_LOG_LEVEL=INFO

# Global safety kill-switch. Set to 1 to block ALL outbound requests regardless of scope.
BBAGENT_DRY_RUN=0
